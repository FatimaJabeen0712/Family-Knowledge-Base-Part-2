<category><pattern>* AND * ARE MARRIED</pattern>
<template><set name="fact_type">married</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: married(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* MARRIED *</pattern>
<template><set name="fact_type">married</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: married(<star index="1"/>, <star index="2"/>).</template></category>

