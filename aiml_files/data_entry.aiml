<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<!-- ADD MALE -->
<category><pattern>ADD MALE *</pattern>
<template><set name="fact_type">male</set><set name="fact_arg1"><star/></set><set name="fact_arg2">none</set><set name="fact_ready">yes</set>Got it! Recorded: male(<star/>).</template></category>

<category><pattern>* IS MALE</pattern>
<template><set name="fact_type">male</set><set name="fact_arg1"><star/></set><set name="fact_arg2">none</set><set name="fact_ready">yes</set>Got it! Recorded: male(<star/>).</template></category>

<category><pattern>* IS A MALE</pattern>
<template><set name="fact_type">male</set><set name="fact_arg1"><star/></set><set name="fact_arg2">none</set><set name="fact_ready">yes</set>Got it! Recorded: male(<star/>).</template></category>

<category><pattern>* IS A MAN</pattern>
<template><set name="fact_type">male</set><set name="fact_arg1"><star/></set><set name="fact_arg2">none</set><set name="fact_ready">yes</set>Got it! Recorded: male(<star/>).</template></category>

<category><pattern>* IS A BOY</pattern>
<template><set name="fact_type">male</set><set name="fact_arg1"><star/></set><set name="fact_arg2">none</set><set name="fact_ready">yes</set>Got it! Recorded: male(<star/>).</template></category>

