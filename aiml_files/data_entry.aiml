<category><pattern>THE DATE OF BIRTH OF * IS *</pattern>
<template><set name="fact_type">dob</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: dob(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* IS BORN IN *</pattern>
<template><set name="fact_type">dob</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: dob(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* DATE OF BIRTH IS *</pattern>
<template><set name="fact_type">dob</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: dob(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* BIRTH YEAR IS *</pattern>
