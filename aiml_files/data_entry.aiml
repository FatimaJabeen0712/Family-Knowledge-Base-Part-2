<!-- ADD NATIONALITY -->
<category><pattern>ADD NATIONALITY * *</pattern>
<template><set name="fact_type">nationality</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: nationality(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* NATIONALITY IS *</pattern>
<template><set name="fact_type">nationality</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: nationality(<star index="1"/>, <star index="2"/>).</template></category>

<!-- COMMANDS -->
<category><pattern>SHOW FACTS</pattern><template>SHOW_FACTS</template></category>
<category><pattern>LIST FACTS</pattern><template>SHOW_FACTS</template></category>
<category><pattern>VIEW FACTS</pattern><template>SHOW_FACTS</template></category>
<category><pattern>SHOW ALL FACTS</pattern><template>SHOW_FACTS</template></category>
<category><pattern>DONE</pattern><template>DONE_ADDING</template></category>
<category><pattern>FINISH</pattern><template>DONE_ADDING</template></category>
<category><pattern>I AM DONE</pattern><template>DONE_ADDING</template></category>
<category><pattern>STOP</pattern><template>DONE_ADDING</template></category>

<category><pattern>HELP</pattern>
<template>Add facts using natural language:
- "[name] is male" or "[name] is a man"
- "[name] is female" or "[name] is a woman"
- "[name] is the parent of [child]"
- "[name] is married to [name]"
- "[name] was born in [year]"
- "add nationality [name] [nationality]"
Commands: SHOW FACTS | DONE</template></category>

<category><pattern>HELLO</pattern>
<template>Hello! I am the Family Fact Collector. Tell me facts about your family and I will add them to the Prolog knowledge base. Type HELP for examples.</template></category>

<category><pattern>HI</pattern>
<template>Hi! Start entering family facts. Type HELP to see how.</template></category>

<category><pattern>*</pattern>
<template>I did not understand that. Try: "[name] is male", "[name] is the parent of [child]", or "[name] was born in [year]". Type HELP for all formats.</template></category>

</aiml>
