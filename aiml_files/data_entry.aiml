<!-- ADD PARENT -->
<category><pattern>ADD PARENT * *</pattern>
<template><set name="fact_type">parent</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: parent(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* IS THE PARENT OF *</pattern>
<template><set name="fact_type">parent</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: parent(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* IS PARENT OF *</pattern>
<template><set name="fact_type">parent</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: parent(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* IS THE FATHER OF *</pattern>
<template><set name="fact_type">parent</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded parent(<star index="1"/>, <star index="2"/>). Also add gender if not done.</template></category>

<category><pattern>* IS THE MOTHER OF *</pattern>
<template><set name="fact_type">parent</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded parent(<star index="1"/>, <star index="2"/>). Also add gender if not done.</template></category>

<category><pattern>* HAS A CHILD NAMED *</pattern>
<template><set name="fact_type">parent</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: parent(<star index="1"/>, <star index="2"/>).</template></category>

<!-- ADD MARRIED -->
<category><pattern>ADD MARRIED * *</pattern>
<template><set name="fact_type">married</set><set name="fact_arg1"><star index="1"/></set><set name="fact_arg2"><star index="2"/></set><set name="fact_ready">yes</set>Got it! Recorded: married(<star index="1"/>, <star index="2"/>).</template></category>

<category><pattern>* IS MARRIED TO *</pattern>
